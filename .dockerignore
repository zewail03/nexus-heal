# Match .gitignore — don't ship secrets, caches, or runtime state into the image.
.env
.env.example
chroma_db/
__pycache__/
*.pyc
.venv/
venv/
.claude/
.pytest_cache/
.run_all_logs/
.git/
.github/

# Runtime SQLite alert store (built fresh in the container)
nexus_alerts.db
nexus_alerts.db-journal
nexus_alerts.db-wal
nexus_alerts.db-shm

# Test scratch + eval tmp
eval/_sweep_tmp/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
