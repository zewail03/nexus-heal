{
  "name": "NEXUS-HEAL Alert Pipeline",
  "nodes": [
    {
      "parameters": {
        "path": "nexus-alert",
        "httpMethod": "POST",
        "responseMode": "lastNode"
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/analyze",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ alert_id: ($json.body && $json.body.alert_id) || $json.alert_id || ('N8N-' + Date.now()), alert_text: ($json.body && $json.body.alert_text) || $json.alert_text || '', source: 'n8n' }) }}",
        "options": {}
      },
      "id": "http-request",
      "name": "Call NEXUS-HEAL API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=\ud83d\udea8 *NEXUS-HEAL Alert*\n\n*Type:* `{{ $json.alert_type }}`\n*Severity:* `{{ $json.severity }}`\n*Confidence:* `{{ Math.round(($json.confidence || 0) * 100) }}%`\n\n*Root Cause:*\n{{ $json.root_cause }}\n\n*Diagnosis:*\n{{ $json.diagnosis }}\n\n*Fix Plan:*\n{{ ($json.fix_plan || []).map((s, i) => (i+1) + '. ' + s).join('\\n') }}\n\n*Estimated Time:* {{ $json.estimated_time || 'n/a' }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-send",
      "name": "Send Telegram Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [750, 300],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Call NEXUS-HEAL API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call NEXUS-HEAL API": {
      "main": [
        [
          {
            "node": "Send Telegram Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
